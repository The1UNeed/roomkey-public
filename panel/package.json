{
  "name": "roomkey-panel",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "roomkey: the panel for a small group's proxy servers (users, quotas, subscriptions), on Cloudflare Workers + D1",
  "cloudflare": {
    "label": "roomkey",
    "products": [
      "Workers",
      "D1"
    ],
    "bindings": {
      "ADMIN_PASSWORD": {
        "description": "后台登录密码，至少 8 位。The admin password for the panel, 8+ characters."
      }
    }
  },
  "scripts": {
    "build": "vite build --config web/vite.config.ts && node scripts/copy-bundle.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "bash e2e/run.sh",
    "bundle": "bash scripts/bundle.sh"
  },
  "dependencies": {
    "hono": "4.13.22",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261125.1",
    "@vitejs/plugin-vue": "6.0.9",
    "hash-wasm": "^4.13.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.168.0"
  }
}
